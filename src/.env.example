ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://specforge:change-me@db:5432/specforge
MIGRATION_MODE=alembic
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
CORS_ORIGINS=https://localhost
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_COUNT=0
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_TIMEOUT_SECONDS=120
AI_KNOWLEDGE_LIMIT=25
LOG_LEVEL=INFO
GIT_ALLOWED_ROOTS=/data/repos

# Phase 25 observability/reliability
LOG_FORMAT=text
LOG_FILE=
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=15
# Operational backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_COUNT=20
ENABLE_BACKUP_SCHEDULER=false
BACKUP_INTERVAL_HOURS=24
